{
  "name": "@morphvpn/capacitor-ping",
  "version": "1.0.0",
  "description": "Native ICMP ping plugin for Capacitor",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "dist/",
    "ios/Plugin/",
    "MorphvpnCapacitorPing.podspec"
  ],
  "author": "MorphVPN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bumoyu-com/morphvpn-ios.git"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "ping",
    "icmp",
    "network"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "verify:web": "npm run build",
    "build": "npm run clean && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.0.0",
    "rimraf": "^5.0.10",
    "rollup": "^4.53.3",
    "typescript": "~5.3.3"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  }
}
